# Copy to .env (install_host.sh does this) and adjust.

# cpu today; switch to cuda after the GPU flip (Milestone 8)
DEVICE=cpu

# --- Models ---
ASR_MODEL=distil-large-v3        # alternative: large-v3
LLM_MODEL=qwen3:14b              # alternatives: gpt-oss:20b, gemma3:12b
#DICTATION_MODEL=qwen3:4b        # optional faster model for the hot path (default: LLM_MODEL)
TTS_BACKEND=kokoro               # fallback: piper
TTS_VOICE=af_heart               # Kokoro US English voice

# --- Service endpoints (host-side view) ---
ASR_PORT=8001
TTS_PORT=8002
LLM_PORT=11434
ASR_URL=http://127.0.0.1:8001
TTS_URL=http://127.0.0.1:8002
LLM_URL=http://127.0.0.1:11434

# --- Host client ---
INJECTION_BACKEND=clipboard      # clipboard (wl-clipboard, v1 default) | ydotool (M9)
HOTKEY=ctrl+alt+space            # push-to-talk; parsed in M3
DB_PATH=~/.local/share/speakcoach/speakcoach.db
AUDIO_KEEP=false                 # retain wavs for future pronunciation v2
