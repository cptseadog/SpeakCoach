# Copy to .env (install_host.sh does this) and adjust.

# cpu = runs anywhere; cuda = needs NVIDIA driver + container toolkit.
# For cuda, also uncomment COMPOSE_FILE below and prefer ASR_MODEL=large-v3.
DEVICE=cpu
#COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# unless-stopped = Docker starts the services at boot and models stay resident
# (~4 GB VRAM idle for large-v3). no = manual control via scripts/preheat.sh.
RESTART_POLICY=unless-stopped

# --- Models ---
ASR_MODEL=distil-large-v3        # alternative: large-v3
LLM_MODEL=qwen3:14b              # alternatives: gpt-oss:20b, gemma3:12b
#DICTATION_MODEL=qwen3:4b        # optional faster model for the hot path (default: LLM_MODEL)
TTS_BACKEND=kokoro               # fallback: piper
TTS_VOICE=af_heart               # Kokoro US English voice

# --- Service endpoints (host-side view) ---
ASR_PORT=8001
TTS_PORT=8002
LLM_PORT=11434
ASR_URL=http://127.0.0.1:8001
TTS_URL=http://127.0.0.1:8002
LLM_URL=http://127.0.0.1:11434

# --- Chat mode ---
CHAT_BACKEND=local               # local (Ollama) | api (OpenAI-compatible provider below)
#CHAT_API_BASE_URL=https://api.openai.com/v1
#CHAT_API_KEY=sk-...
#CHAT_API_MODEL=gpt-4o-mini      # whatever your provider names its model

# --- Host client ---
INJECTION_BACKEND=clipboard      # clipboard = default, no setup | ydotool = optional
                                 # auto-type, needs a daemon + input group (see README)
HOTKEY=ctrl+alt+space            # push-to-talk; parsed in M3
DB_PATH=~/.local/share/speakcoach/speakcoach.db
AUDIO_KEEP=false                 # retain wavs for future pronunciation v2
