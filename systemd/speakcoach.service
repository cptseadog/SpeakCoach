# Always-on dictation loop (user unit — no sudo). Install:
#   cp systemd/speakcoach.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now speakcoach
# Then trigger recording from anywhere via the GNOME custom shortcut
# (sh -c 'kill -USR1 $(cat $XDG_RUNTIME_DIR/speakcoach-dictate.pid)')
# or `speakcoach toggle`; desktop notifications provide the feedback.
[Unit]
Description=SpeakCoach dictation (push-to-talk to clipboard)
After=graphical-session.target

[Service]
# Adjust if the repo lives elsewhere.
WorkingDirectory=%h/projects/spoken-english-tutor/host_client
# Bring the containers up if RESTART_POLICY=no (no-op when already warm). The
# leading "-" keeps a failure non-fatal: the loop still starts and reports
# per-utterance errors rather than refusing to run at all.
ExecStartPre=-%h/projects/spoken-english-tutor/scripts/preheat.sh
ExecStart=/usr/bin/env uv run speakcoach dictate
# wl-copy and audio need the session; user units get XDG_RUNTIME_DIR/DBus
# automatically, but not the Wayland display name.
Environment=WAYLAND_DISPLAY=wayland-0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
